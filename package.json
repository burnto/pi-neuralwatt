{
	"name": "@burnto/pi-neuralwatt",
	"version": "0.2.0",
	"type": "module",
	"description": "Neuralwatt provider for pi. Shows the reported request cost in pi's footer and provider-reported session energy in the status area.",
	"keywords": ["pi-package", "neuralwatt", "energy", "provider"],
	"license": "MIT",
	"author": "burnto",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/burnto/pi-neuralwatt.git"
	},
	"homepage": "https://github.com/burnto/pi-neuralwatt#readme",
	"bugs": "https://github.com/burnto/pi-neuralwatt/issues",
	"files": ["index.ts", "lib.ts", "README.md", "assets"],
	"pi": {
		"extensions": ["./index.ts"],
		"image": "https://raw.githubusercontent.com/burnto/pi-neuralwatt/main/assets/equivalents.gif"
	},
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"check": "npm run typecheck && npm test",
		"prepublishOnly": "npm run check"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^1.0.0",
		"@earendil-works/pi-coding-agent": "^1.0.0",
		"@types/node": "^22.10.0",
		"typescript": "^5.7.2",
		"vitest": "^3.2.4"
	},
	"publishConfig": {
		"access": "public"
	}
}
